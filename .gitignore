# Build and runtime caches. Required ONNX policy files remain versioned.
.cache/
.build/
build/
__pycache__/
*.py[cod]
*.o
*.a
*.elf
*.bin
*.hex
*.map
*.lst
*.d
.venv/
venv/

# Local settings, logs and temporary archives.
.env
.env.*
!.env.example
*.log
*.tmp
*.bak

# local secrets (API keys, tokens)
.env
.env.*
!.env.example

# per-duck settings and secrets written on the board
data/

*.orig
*.rej
*.zip
*.rar
.DS_Store
Thumbs.db

# Local validation scripts are not part of the distributed app.
tests/
test_*.py
*_test.py
.pytest_cache/
.coverage*
htmlcov/

# The duck-connect service keeps its tests in the repo.
!connect/tests/
!connect/tests/**
